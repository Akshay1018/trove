{
  "name": "create-node-backend-temp",
  "version": "1.0.0",
  "description": "A powerful and flexible CLI tool for creating modern Node.js backend applications with best practices and CI/CD pipelines baked in",
  "main": "dist/src/cli.js",
  "types": "dist/index.d.ts",
  "bin": {
    "create-node-backend-temp": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --noEmit false && cp -r src/templates/* dist/src/templates/",
    "watch": "tsc -w",
    "dev": "ts-node src/cli.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install",
    "prepublishOnly": "npm run build",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "cli",
    "nodejs",
    "backend",
    "express",
    "koa",
    "nestjs",
    "fastify",
    "typescript",
    "generator",
    "boilerplate",
    "scaffold",
    "template",
    "ci-cd",
    "github-actions",
    "gitlab-ci",
    "bitbucket-pipelines",
    "docker",
    "mongodb",
    "postgresql",
    "mysql",
    "authentication",
    "jwt",
    "oauth"
  ],
  "author": {
    "name": "Akshay Kumar",
    "email": "ak715173@gmail.com",
    "url": "https://github.com/Akshay1018"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akshay1018/trove.git"
  },
  "bugs": {
    "url": "https://github.com/Akshay1018/trove/issues"
  },
  "homepage": "https://github.com/Akshay1018/trove#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.3",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "helmet": "^7.1.0",
    "inquirer": "^8.2.6",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.2",
    "ora": "^5.4.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.1",
    "typeorm": "^0.3.20",
    "winston": "^3.11.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.13",
    "@nestjs/core": "^11.0.13",
    "@nestjs/swagger": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/helmet": "^4.0.0",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "fastify": "^5.2.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "validate-npm-package-name": "^5.0.0"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
