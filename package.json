{
  "name": "trove-cli",
  "version": "1.0.0",
  "description": "A powerful and flexible CLI tool for creating modern Node.js backend applications with best practices and CI/CD pipelines baked in",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "trove": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --noEmit false && cp -r templates dist/",
    "watch": "tsc -w",
    "dev": "ts-node src/cli.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install",
    "prepublishOnly": "npm run build",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "cli",
    "nodejs",
    "backend",
    "express",
    "koa",
    "nestjs",
    "fastify",
    "typescript",
    "generator",
    "boilerplate",
    "scaffold",
    "template",
    "ci-cd",
    "github-actions",
    "gitlab-ci",
    "bitbucket-pipelines",
    "docker",
    "mongodb",
    "postgresql",
    "mysql",
    "authentication",
    "jwt",
    "oauth"
  ],
  "author": {
    "name": "Akshay Kumar",
    "email": "ak715173@gmail.com",
    "url": "https://github.com/Akshay1018"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akshay1018/trove.git"
  },
  "bugs": {
    "url": "https://github.com/Akshay1018/trove/issues"
  },
  "homepage": "https://github.com/Akshay1018/trove#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "ejs": "^3.1.9",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "typescript": "^5.3.3",
    "validate-npm-package-name": "^5.0.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.13",
    "@nestjs/core": "^11.0.13",
    "@nestjs/swagger": "^11.1.0",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/helmet": "^4.0.0",
    "@types/inquirer": "^8.2.6",
    "@types/jest": "^29.5.11",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "fastify": "^5.2.2",
    "helmet": "^8.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
