{
  "name": "create-backend-app",
  "version": "1.0.0",
  "description": "A CLI tool to create backend applications with various frameworks",
  "main": "dist/index.js",
  "bin": {
    "create-backend-app": "./dist/index.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cli",
    "backend",
    "generator",
    "express",
    "nestjs",
    "fastify",
    "koa",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ejs": "^3.1.9",
    "execa": "^8.0.1",
    "glob": "^10.3.10",
    "inquirer": "^9.2.12",
    "listr": "^0.14.3",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.23.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/create-backend-app.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/create-backend-app/issues"
  },
  "homepage": "https://github.com/yourusername/create-backend-app#readme"
}
