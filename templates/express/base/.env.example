# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

<% if (database === 'mongodb') { %># MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/<%= projectName %>
<% } else if (database === 'postgresql') { %># PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=<%= projectName %>
<% } else if (database === 'mysql') { %># MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=<%= projectName %>
<% } %>

<% if (auth === 'jwt') { %># JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1d
<% } else if (auth === 'session') { %># Session Configuration
SESSION_SECRET=your-session-secret
<% } else if (auth === 'oauth') { %># OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
<% } %> 