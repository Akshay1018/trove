  "koa-logger": "^3.2.1",
  "dotenv": "^16.4.5",
  "winston": "^3.11.0",
  "pg": "^8.11.3",
  "@types/pg": "^8.11.0",
  "typeorm": "^0.3.20",
  "@nestjs/typeorm": "^10.0.2",
  "jsonwebtoken": "^9.0.2",
  "bcryptjs": "^2.4.3"
},
  "devDependencies": {
  "@types/koa": "^2.14.0",
  "@types/koa__router": "^12.0.4",
