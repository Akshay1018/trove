  "eslint": "^8.57.0",
  "eslint-config-prettier": "^9.1.0",
  "eslint-plugin-prettier": "^5.1.3",
  "prettier": "^3.2.5",
  "jest": "^29.7.0",
  "@types/jest": "^29.5.12",
  "ts-jest": "^29.1.2",
  "supertest": "^6.3.4",
  "@types/supertest": "^6.0.2",
  "@types/jsonwebtoken": "^9.0.5",
  "@types/bcryptjs": "^2.4.6"
