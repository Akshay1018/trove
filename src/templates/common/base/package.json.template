{
  "name": "<%= projectName %>",
  "version": "1.0.0",
  "description": "A modern Node.js backend application",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    <% Object.entries(dependencies).forEach(([name, version], index) => { %>
    "<%= name %>": "<%= version %>"<%= index < Object.keys(dependencies).length - 1 ? ',' : '' %>
    <% }); %>
  },
  "devDependencies": {
    <% Object.entries(devDependencies).forEach(([name, version], index) => { %>
    "<%= name %>": "<%= version %>"<%= index < Object.keys(devDependencies).length - 1 ? ',' : '' %>
    <% }); %>
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "MIT"
} 