import { connect, disconnect } from '../../database';
import { UserRepository } from '../../repositories/user.repository';
import { PostRepository } from '../../repositories/post.repository';
import { User } from '../../models/user.model';
import { Post } from '../../models/post.model';
import { DatabaseError } from '../../errors/database.error';

describe('Repositories', () => {
  let userRepository: UserRepository;
  let postRepository: PostRepository;

  beforeAll(async () => {
    await connect();
    userRepository = new UserRepository();
    postRepository = new PostRepository();
  });

  afterAll(async () => {
    await disconnect();
  });

  afterEach(async () => {
    await User.deleteMany({});
    await Post.deleteMany({});
  });

  describe('UserRepository', () => {
    describe('create', () => {
      it('should create a new user', async () => {
        const userData = {
          email: 'test@example.com',
          password: 'Password123!',
          name: 'Test User'
        };

        const user = await userRepository.create(userData);

        expect(user).toHaveProperty('_id');
        expect(user.email).toBe(userData.email);
        expect(user.name).toBe(userData.name);
      });

      it('should throw on duplicate email', async () => {
        const userData = {
          email: 'test@example.com',
          password: 'Password123!',
          name: 'Test User'
        };

        await userRepository.create(userData);

        await expect(userRepository.create(userData))
          .rejects
          .toThrow(DatabaseError);
      });
    });

    describe('findById', () => {
      it('should find user by id', async () => {
        const created = await userRepository.create({
          email: 'test@example.com',
          password: 'Password123!',
          name: 'Test User'
        });

        const found = await userRepository.findById(created._id);

        expect(found).toBeDefined();
        expect(found?._id.toString()).toBe(created._id.toString());
      });

      it('should return null for non-existent id', async () => {
        const nonExistentId = '507f1f77bcf86cd799439011';
        const user = await userRepository.findById(nonExistentId);

        expect(user).toBeNull();
      });
    });

    describe('findByEmail', () => {
      it('should find user by email', async () => {
        const userData = {
          email: 'test@example.com',
          password: 'Password123!',
          name: 'Test User'
        };

        await userRepository.create(userData);

        const found = await userRepository.findByEmail(userData.email);

        expect(found).toBeDefined();
        expect(found?.email).toBe(userData.email);
      });

      it('should return null for non-existent email', async () => {
        const user = await userRepository.findByEmail('nonexistent@example.com');

        expect(user).toBeNull();
      });
    });

    describe('update', () => {
      it('should update user fields', async () => {
        const created = await userRepository.create({
          email: 'test@example.com',
          password: 'Password123!',
          name: 'Test User'
        });

        const updated = await userRepository.update(created._id, {
          name: 'Updated Name'
        });

        expect(updated).toBeDefined();
        expect(updated?.name).toBe('Updated Name');
        expect(updated?.email).toBe(created.email);
      });

      it('should throw on non-existent id', async () => {
        const nonExistentId = '507f1f77bcf86cd799439011';

        await expect(userRepository.update(nonExistentId, {
          name: 'Updated Name'
        })).rejects.toThrow(DatabaseError);
      });
    });

    describe('delete', () => {
      it('should delete user', async () => {
        const created = await userRepository.create({
          email: 'test@example.com',
          password: 'Password123!',
          name: 'Test User'
        });

        await userRepository.delete(created._id);

        const found = await userRepository.findById(created._id);
        expect(found).toBeNull();
      });

      it('should throw on non-existent id', async () => {
        const nonExistentId = '507f1f77bcf86cd799439011';

        await expect(userRepository.delete(nonExistentId))
          .rejects
          .toThrow(DatabaseError);
      });
    });
  });

  describe('PostRepository', () => {
    let author: any;

    beforeEach(async () => {
      author = await userRepository.create({
        email: 'author@example.com',
        password: 'Password123!',
        name: 'Test Author'
      });
    });

    describe('create', () => {
      it('should create a new post', async () => {
        const postData = {
          title: 'Test Post',
          content: 'Test content',
          author: author._id
        };

        const post = await postRepository.create(postData);

        expect(post).toHaveProperty('_id');
        expect(post.title).toBe(postData.title);
        expect(post.content).toBe(postData.content);
        expect(post.author.toString()).toBe(author._id.toString());
      });

      it('should throw on invalid author id', async () => {
        const postData = {
          title: 'Test Post',
          content: 'Test content',
          author: '507f1f77bcf86cd799439011'
        };

        await expect(postRepository.create(postData))
          .rejects
          .toThrow(DatabaseError);
      });
    });

    describe('findWithPagination', () => {
      beforeEach(async () => {
        // Create 5 posts
        await Promise.all(Array(5).fill(null).map((_, i) =>
          postRepository.create({
            title: `Post ${i + 1}`,
            content: `Content ${i + 1}`,
            author: author._id
          })
        ));
      });

      it('should return paginated results', async () => {
        const { items: page1, total } = await postRepository.findWithPagination({
          page: 1,
          limit: 3
        });

        const { items: page2 } = await postRepository.findWithPagination({
          page: 2,
          limit: 3
        });

        expect(total).toBe(5);
        expect(page1).toHaveLength(3);
        expect(page2).toHaveLength(2);
      });

      it('should support filtering by author', async () => {
        const anotherAuthor = await userRepository.create({
          email: 'another@example.com',
          password: 'Password123!',
          name: 'Another Author'
        });

        await postRepository.create({
          title: 'Another Post',
          content: 'Another content',
          author: anotherAuthor._id
        });

        const { items, total } = await postRepository.findWithPagination({
          page: 1,
          limit: 10,
          filters: { author: author._id }
        });

        expect(total).toBe(5);
        expect(items).toHaveLength(5);
        items.forEach(post => {
          expect(post.author.toString()).toBe(author._id.toString());
        });
      });

      it('should support sorting', async () => {
        const { items } = await postRepository.findWithPagination({
          page: 1,
          limit: 10,
          sort: { createdAt: -1 }
        });

        for (let i = 1; i < items.length; i++) {
          expect(items[i-1].createdAt.getTime())
            .toBeGreaterThanOrEqual(items[i].createdAt.getTime());
        }
      });
    });

    describe('findById', () => {
      it('should populate author', async () => {
        const created = await postRepository.create({
          title: 'Test Post',
          content: 'Test content',
          author: author._id
        });

        const found = await postRepository.findById(created._id);

        expect(found).toBeDefined();
        expect(found?.author).toHaveProperty('name', author.name);
      });
    });

    describe('update', () => {
      it('should update post fields', async () => {
        const created = await postRepository.create({
          title: 'Test Post',
          content: 'Test content',
          author: author._id
        });

        const updated = await postRepository.update(created._id, {
          title: 'Updated Title',
          content: 'Updated content'
        });

        expect(updated).toBeDefined();
        expect(updated?.title).toBe('Updated Title');
        expect(updated?.content).toBe('Updated content');
        expect(updated?.author.toString()).toBe(author._id.toString());
      });
    });

    describe('incrementViews', () => {
      it('should increment views count', async () => {
        const created = await postRepository.create({
          title: 'Test Post',
          content: 'Test content',
          author: author._id
        });

        await postRepository.incrementViews(created._id);
        await postRepository.incrementViews(created._id);

        const updated = await postRepository.findById(created._id);
        expect(updated?.views).toBe(2);
      });
    });
  });
}); 