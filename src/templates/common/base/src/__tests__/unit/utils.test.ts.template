import { validateEmail, hashPassword, comparePasswords } from '../../utils/auth';
import { formatDate, generateSlug, sanitizeInput } from '../../utils/formatting';
import { paginateResults, sortResults } from '../../utils/query';
import { generateToken, verifyToken } from '../../utils/jwt';

describe('Authentication Utilities', () => {
  describe('Email Validation', () => {
    it('should validate correct email formats', () => {
      expect(validateEmail('test@example.com')).toBe(true);
      expect(validateEmail('user.name+tag@subdomain.example.co.uk')).toBe(true);
    });

    it('should reject invalid email formats', () => {
      expect(validateEmail('invalid-email')).toBe(false);
      expect(validateEmail('missing@domain')).toBe(false);
      expect(validateEmail('@nodomain.com')).toBe(false);
      expect(validateEmail('spaces in@email.com')).toBe(false);
    });
  });

  describe('Password Hashing', () => {
    const password = 'TestPassword123!';

    it('should hash passwords consistently', async () => {
      const hash1 = await hashPassword(password);
      const hash2 = await hashPassword(password);

      expect(hash1).not.toBe(password);
      expect(hash2).not.toBe(password);
      expect(hash1).not.toBe(hash2); // Different salts
    });

    it('should verify hashed passwords correctly', async () => {
      const hash = await hashPassword(password);
      
      const validMatch = await comparePasswords(password, hash);
      expect(validMatch).toBe(true);

      const invalidMatch = await comparePasswords('WrongPassword123!', hash);
      expect(invalidMatch).toBe(false);
    });
  });
});

describe('Formatting Utilities', () => {
  describe('Date Formatting', () => {
    const testDate = new Date('2024-03-15T14:30:00Z');

    it('should format dates in various styles', () => {
      expect(formatDate(testDate, 'short')).toBe('3/15/24');
      expect(formatDate(testDate, 'medium')).toBe('Mar 15, 2024');
      expect(formatDate(testDate, 'long')).toBe('March 15, 2024');
      expect(formatDate(testDate, 'iso')).toBe('2024-03-15T14:30:00Z');
    });

    it('should handle invalid dates', () => {
      expect(() => formatDate(new Date('invalid'))).toThrow();
    });
  });

  describe('Slug Generation', () => {
    it('should generate valid slugs', () => {
      expect(generateSlug('Hello World!')).toBe('hello-world');
      expect(generateSlug('This & That')).toBe('this-and-that');
      expect(generateSlug('Multiple   Spaces')).toBe('multiple-spaces');
      expect(generateSlug('Special@#$Characters')).toBe('special-characters');
    });

    it('should handle edge cases', () => {
      expect(generateSlug('')).toBe('');
      expect(generateSlug('   ')).toBe('');
      expect(generateSlug('!!!!')).toBe('');
    });
  });

  describe('Input Sanitization', () => {
    it('should remove dangerous HTML', () => {
      expect(sanitizeInput('<script>alert("xss")</script>Hello')).toBe('Hello');
      expect(sanitizeInput('<img src="x" onerror="alert(1)">')).toBe('');
    });

    it('should preserve safe HTML when configured', () => {
      expect(sanitizeInput('<p><b>Safe</b> HTML</p>', { allowTags: ['p', 'b'] }))
        .toBe('<p><b>Safe</b> HTML</p>');
    });
  });
});

describe('Query Utilities', () => {
  describe('Pagination', () => {
    const items = Array.from({ length: 100 }, (_, i) => ({ id: i + 1 }));

    it('should paginate results correctly', () => {
      const page1 = paginateResults(items, { page: 1, limit: 10 });
      expect(page1.results).toHaveLength(10);
      expect(page1.total).toBe(100);
      expect(page1.page).toBe(1);
      expect(page1.totalPages).toBe(10);

      const page2 = paginateResults(items, { page: 2, limit: 10 });
      expect(page2.results[0].id).toBe(11);
    });

    it('should handle edge cases', () => {
      const emptyPage = paginateResults([], { page: 1, limit: 10 });
      expect(emptyPage.results).toHaveLength(0);
      expect(emptyPage.total).toBe(0);

      const outOfBounds = paginateResults(items, { page: 11, limit: 10 });
      expect(outOfBounds.results).toHaveLength(0);
    });
  });

  describe('Sorting', () => {
    const items = [
      { name: 'Charlie', age: 30 },
      { name: 'Alice', age: 25 },
      { name: 'Bob', age: 35 }
    ];

    it('should sort by single field', () => {
      const sortedByName = sortResults(items, { field: 'name', order: 'asc' });
      expect(sortedByName[0].name).toBe('Alice');
      expect(sortedByName[2].name).toBe('Charlie');

      const sortedByAge = sortResults(items, { field: 'age', order: 'desc' });
      expect(sortedByAge[0].age).toBe(35);
      expect(sortedByAge[2].age).toBe(25);
    });

    it('should handle invalid sort fields', () => {
      expect(() => sortResults(items, { field: 'invalid', order: 'asc' }))
        .toThrow();
    });
  });
});

describe('JWT Utilities', () => {
  const payload = { userId: '123', role: 'user' };

  it('should generate valid tokens', () => {
    const token = generateToken(payload);
    expect(typeof token).toBe('string');
    expect(token.split('.')).toHaveLength(3);
  });

  it('should verify and decode tokens', () => {
    const token = generateToken(payload);
    const decoded = verifyToken(token);

    expect(decoded).toBeDefined();
    expect(decoded.userId).toBe(payload.userId);
    expect(decoded.role).toBe(payload.role);
  });

  it('should reject invalid tokens', () => {
    expect(() => verifyToken('invalid.token')).toThrow();
    expect(() => verifyToken('')).toThrow();
  });

  it('should handle expired tokens', () => {
    const expiredToken = generateToken(payload, { expiresIn: '0s' });
    expect(() => verifyToken(expiredToken)).toThrow(/expired/i);
  });
}); 