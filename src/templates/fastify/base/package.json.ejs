{
  "name": "<%= projectName %>",
  "version": "1.0.0",
  "description": "Fastify backend application",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^8.4.1",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^1.10.1",
    "fastify": "^4.24.3",
    "fastify-plugin": "^4.5.1",
    "pino-pretty": "^10.2.3"<% if (database === 'mongodb') { %>,
    "mongoose": "^8.0.3"<% } else if (database === 'postgresql') { %>,
    "pg": "^8.11.3",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0"<% } else if (database === 'mysql') { %>,
    "mysql2": "^3.6.5",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0"<% } %><% if (auth === 'jwt') { %>,
    "@fastify/jwt": "^7.2.3",
    "bcryptjs": "^2.4.3"<% } else if (auth === 'session') { %>,
    "@fastify/session": "^10.5.0",
    "@fastify/cookie": "^9.1.0"<% } else if (auth === 'oauth') { %>,
    "@fastify/oauth2": "^7.7.0"<% } %>
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"<% if (auth === 'jwt') { %>,
    "@types/bcryptjs": "^2.4.6"<% } %>
  }
} 