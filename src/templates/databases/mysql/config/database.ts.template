import mysql from 'mysql2/promise';
import { config } from './index';
import { logger } from '../utils/logger';

const pool = mysql.createPool({
  uri: config.database.url,
  ...config.database.options,
  waitForConnections: true,
  connectionLimit: 10,
  queueLimit: 0
});

pool.on('connection', () => {
  logger.info('MySQL Connected');
});

pool.on('error', (err) => {
  logger.error('Unexpected error on idle client', err);
  process.exit(1);
});

export const query = async (sql: string, params?: any[]): Promise<any> => {
  const start = Date.now();
  try {
    const [results] = await pool.execute(sql, params);
    const duration = Date.now() - start;
    logger.debug('Executed query', { sql, duration });
    return results;
  } catch (error) {
    logger.error('Error executing query', { sql, error });
    throw error;
  }
};

export const getConnection = async () => {
  const connection = await pool.getConnection();
  const query = connection.query.bind(connection);
  const release = connection.release.bind(connection);

  // Monkey patch the query method to add logging
  connection.query = (...args: any[]) => {
    const start = Date.now();
    return query(...args).then((result: any) => {
      const duration = Date.now() - start;
      logger.debug('Executed query', { sql: args[0], duration });
      return result;
    });
  };

  return connection;
};

export const closePool = async (): Promise<void> => {
  try {
    await pool.end();
    logger.info('Database pool closed');
  } catch (error) {
    logger.error('Error closing database pool:', error);
    throw error;
  }
}; 