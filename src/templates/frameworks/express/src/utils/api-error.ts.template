import { HttpStatus } from '../types/http';

export class ApiError extends Error {
  constructor(
    message: string,
    public statusCode: HttpStatus = HttpStatus.INTERNAL_SERVER_ERROR,
    public originalError?: unknown
  ) {
    super(message);
    this.name = 'ApiError';
    Error.captureStackTrace(this, this.constructor);
  }

  toJSON() {
    return {
      error: {
        name: this.name,
        message: this.message,
        statusCode: this.statusCode,
        stack: process.env.NODE_ENV === 'development' ? this.stack : undefined,
      },
    };
  }

  static badRequest(message: string, originalError?: unknown): ApiError {
    return new ApiError(message, HttpStatus.BAD_REQUEST, originalError);
  }

  static unauthorized(message: string, originalError?: unknown): ApiError {
    return new ApiError(message, HttpStatus.UNAUTHORIZED, originalError);
  }

  static forbidden(message: string, originalError?: unknown): ApiError {
    return new ApiError(message, HttpStatus.FORBIDDEN, originalError);
  }

  static notFound(message: string, originalError?: unknown): ApiError {
    return new ApiError(message, HttpStatus.NOT_FOUND, originalError);
  }

  static conflict(message: string, originalError?: unknown): ApiError {
    return new ApiError(message, HttpStatus.CONFLICT, originalError);
  }

  static unprocessableEntity(message: string, originalError?: unknown): ApiError {
    return new ApiError(message, HttpStatus.UNPROCESSABLE_ENTITY, originalError);
  }

  static internal(message: string, originalError?: unknown): ApiError {
    return new ApiError(message, HttpStatus.INTERNAL_SERVER_ERROR, originalError);
  }
} 