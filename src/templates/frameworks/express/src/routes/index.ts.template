import { Router } from 'express';
<% if (auth !== 'skip') { %>
import { authRoutes } from './auth.routes';
<% } %>

const router = Router();

// Health check
router.get('/health', (req, res) => {
  res.json({
    status: 'ok',
    timestamp: new Date().toISOString(),
    uptime: process.uptime()
  });
});

<% if (auth !== 'skip') { %>
// Auth routes
router.use('/auth', authRoutes);
<% } %>

export { router as routes }; 