import { Model, Document, FilterQuery, UpdateQuery } from 'mongoose';
import { HttpStatus } from '../types/http';
import { ApiError } from '../utils/api-error';
import { Logger } from '../utils/logger';

export abstract class BaseService {
  protected logger: Logger;
  protected serviceName: string;

  constructor(serviceName: string) {
    this.serviceName = serviceName;
    this.logger = new Logger(serviceName);
  }

  protected async handleRequest<T>(
    operation: string,
    requestFn: () => Promise<T>,
    errorMessage = 'Operation failed'
  ): Promise<T> {
    try {
      this.logger.info(`Starting ${operation}`);
      const result = await requestFn();
      this.logger.info(`Completed ${operation}`);
      return result;
    } catch (error) {
      this.logger.error(`Error in ${operation}:`, error);
      
      if (error instanceof ApiError) {
        throw error;
      }

      throw new ApiError(
        errorMessage,
        HttpStatus.INTERNAL_SERVER_ERROR,
        error as Error
      );
    }
  }

  protected validateId(id: string | number, entityName: string): void {
    if (!id) {
      throw new ApiError(
        `Invalid ${entityName} ID provided`,
        HttpStatus.BAD_REQUEST
      );
    }
  }

  protected validateRequired(
    value: unknown,
    fieldName: string,
    entityName: string
  ): void {
    if (value === undefined || value === null || value === '') {
      throw new ApiError(
        `${fieldName} is required for ${entityName}`,
        HttpStatus.BAD_REQUEST
      );
    }
  }

  protected validateExists<T>(
    entity: T | null | undefined,
    entityName: string,
    id?: string | number
  ): void {
    if (!entity) {
      const message = id
        ? `${entityName} with ID ${id} not found`
        : `${entityName} not found`;
      throw new ApiError(message, HttpStatus.NOT_FOUND);
    }
  }

  protected validatePermission(
    condition: boolean,
    message = 'Permission denied'
  ): void {
    if (!condition) {
      throw new ApiError(message, HttpStatus.FORBIDDEN);
    }
  }

  protected validateUnique(
    exists: boolean,
    entityName: string,
    field: string
  ): void {
    if (exists) {
      throw new ApiError(
        `${entityName} with this ${field} already exists`,
        HttpStatus.CONFLICT
      );
    }
  }

  protected async validateAsync<T>(
    validationFn: () => Promise<T>,
    errorMessage: string
  ): Promise<T> {
    try {
      return await validationFn();
    } catch (error) {
      throw new ApiError(errorMessage, HttpStatus.BAD_REQUEST, error as Error);
    }
  }
}

export class BaseService<T extends Document> extends BaseService {
  constructor(protected readonly model: Model<T>) {
    super(model.collection.name);
  }

  async create(data: Partial<T>): Promise<T> {
    try {
      const document = new this.model(data);
      return await document.save();
    } catch (error) {
      throw new ApiError('Failed to create document', HttpStatus.INTERNAL_SERVER_ERROR, error);
    }
  }

  async findById(id: string): Promise<T | null> {
    try {
      return await this.model.findById(id);
    } catch (error) {
      throw new ApiError('Failed to find document by ID', HttpStatus.INTERNAL_SERVER_ERROR, error);
    }
  }

  async findOne(filter: FilterQuery<T>): Promise<T | null> {
    try {
      return await this.model.findOne(filter);
    } catch (error) {
      throw new ApiError('Failed to find document', HttpStatus.INTERNAL_SERVER_ERROR, error);
    }
  }

  async find(filter: FilterQuery<T>, skip?: number, limit?: number): Promise<T[]> {
    try {
      let query = this.model.find(filter);
      
      if (typeof skip === 'number') {
        query = query.skip(skip);
      }
      
      if (typeof limit === 'number') {
        query = query.limit(limit);
      }
      
      return await query.exec();
    } catch (error) {
      throw new ApiError('Failed to find documents', HttpStatus.INTERNAL_SERVER_ERROR, error);
    }
  }

  async update(id: string, update: UpdateQuery<T>): Promise<T | null> {
    try {
      return await this.model.findByIdAndUpdate(id, update, { new: true });
    } catch (error) {
      throw new ApiError('Failed to update document', HttpStatus.INTERNAL_SERVER_ERROR, error);
    }
  }

  async delete(id: string): Promise<T | null> {
    try {
      return await this.model.findByIdAndDelete(id);
    } catch (error) {
      throw new ApiError('Failed to delete document', HttpStatus.INTERNAL_SERVER_ERROR, error);
    }
  }

  async count(filter: FilterQuery<T>): Promise<number> {
    try {
      return await this.model.countDocuments(filter);
    } catch (error) {
      throw new ApiError('Failed to count documents', HttpStatus.INTERNAL_SERVER_ERROR, error);
    }
  }

  async exists(filter: FilterQuery<T>): Promise<boolean> {
    try {
      return await this.model.exists(filter) !== null;
    } catch (error) {
      throw new ApiError('Failed to check document existence', HttpStatus.INTERNAL_SERVER_ERROR, error);
    }
  }
} 