import Router from '@koa/router';
<% if (auth !== 'skip') { %>
import authRoutes from './auth.routes';
<% } %>


const router = new Router();

<% if (auth !== 'skip') { %>
router.use('/auth', authRoutes.routes(), authRoutes.allowedMethods());
<% } %>
router.get('/health', (ctx) => {
  ctx.body = { status: 'ok' };
});

export default router;
