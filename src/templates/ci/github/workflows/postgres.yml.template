# This file defines the PostgreSQL service for GitHub Actions CI
# It is intended to be included or referenced by the main ci.yml workflow.
postgres:
  image: postgres:15 # Use a specific version for stability
  env:
    POSTGRES_USER: testuser
    POSTGRES_PASSWORD: testpassword
    POSTGRES_DB: test_db # Use consistent test_db name
  ports:
    - 5432:5432
  # Options to ensure the service is ready before tests run
  options: >-
    --health-cmd pg_isready
    --health-interval 10s
    --health-timeout 5s
    --health-retries 5 