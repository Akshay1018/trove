// TODO: Implement template

image: node:20.11.1

definitions:
  services:
    mongodb:
      image: mongo:7.0
      variables:
        MONGO_INITDB_ROOT_USERNAME: $MONGODB_USERNAME
        MONGO_INITDB_ROOT_PASSWORD: $MONGODB_PASSWORD
  caches:
    npm: ~/.npm
  steps:
    - step: &build-test
        name: Build and Test
        services:
          - mongodb
        caches:
          - npm
        script:
          - npm ci
          - npm run lint
          - |
            # Wait for MongoDB to be ready
            echo "Waiting for MongoDB to be ready..."
            timeout 30s bash -c 'until mongosh --host mongodb --port 27017 --eval "print(\"waited for connection\")" > /dev/null 2>&1; do sleep 0.5; done'
          - npm run test
          - npm run build
        artifacts:
          - dist/**
    - step: &deploy-staging
        name: Deploy to Staging
        deployment: staging
        trigger: manual
        script:
          - pipe: atlassian/heroku-deploy:2.1.1
            variables:
              HEROKU_API_KEY: $HEROKU_API_KEY
              HEROKU_APP_NAME: $HEROKU_STAGING_APP
              ZIP_FILE: "dist.tar.gz"
              WAIT: "true"
          - |
            # Verify MongoDB connection in staging
            curl --retry 5 --retry-delay 5 "$HEROKU_STAGING_APP.herokuapp.com/api/health"
    - step: &deploy-production
        name: Deploy to Production
        deployment: production
        trigger: manual
        script:
          - pipe: atlassian/heroku-deploy:2.1.1
            variables:
              HEROKU_API_KEY: $HEROKU_API_KEY
              HEROKU_APP_NAME: $HEROKU_PRODUCTION_APP
              ZIP_FILE: "dist.tar.gz"
              WAIT: "true"
          - |
            # Verify MongoDB connection in production
            curl --retry 5 --retry-delay 5 "$HEROKU_PRODUCTION_APP.herokuapp.com/api/health"

pipelines:
  default:
    - step: *build-test
  branches:
    main:
      - step: *build-test
      - step: *deploy-staging
      - step: *deploy-production
    develop:
      - step: *build-test
      - step: *deploy-staging
    feature/*:
      - step: *build-test
  pull-requests:
    '**':
      - step: *build-test
  tags:
    'v*':
      - step: *build-test
      - step: *deploy-production

  custom:
    mongodb-backup:
      - step:
          name: Backup MongoDB
          services:
            - mongodb
          script:
            - apt-get update && apt-get install -y mongodb-clients
            - |
              mongodump \
                --uri="mongodb://$MONGODB_USERNAME:$MONGODB_PASSWORD@mongodb:27017" \
                --archive="backup-$(date +%Y%m%d).gz" \
                --gzip
            - pipe: atlassian/aws-s3-deploy:1.1.0
              variables:
                AWS_ACCESS_KEY_ID: $AWS_ACCESS_KEY_ID
                AWS_SECRET_ACCESS_KEY: $AWS_SECRET_ACCESS_KEY
                AWS_DEFAULT_REGION: $AWS_DEFAULT_REGION
                S3_BUCKET: $BACKUP_BUCKET
                LOCAL_PATH: 'backup-*.gz'
    mongodb-restore:
      - step:
          name: Restore MongoDB
          services:
            - mongodb
          script:
            - apt-get update && apt-get install -y mongodb-clients awscli
            - |
              # Download latest backup
              aws s3 cp \
                s3://$BACKUP_BUCKET/backup-$(date +%Y%m%d).gz \
                ./backup.gz
            - |
              mongorestore \
                --uri="mongodb://$MONGODB_USERNAME:$MONGODB_PASSWORD@mongodb:27017" \
                --gzip \
                --archive=backup.gz \
                --drop

options:
  max-time: 30
  size: 2x
