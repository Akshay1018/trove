image: node:20.11.1

definitions:
  caches:
    npm: ~/.npm
  services: 
    mysql:
      image: mysql:8.0
      variables:
        MYSQL_ROOT_PASSWORD: root
        MYSQL_DATABASE: test_db
    mongo:
      image: mongo:6.0
    postgres:
      image: postgres:15
      variables:
        POSTGRES_USER: testuser
        POSTGRES_PASSWORD: testpassword
        POSTGRES_DB: test_db
  steps:
    - step: &build-test
        name: Build and Test
        caches:
          - npm
        services:
          <% if (database === 'mysql') { %>
          - mysql
          <% } else if (database === 'mongodb') { %>
          - mongo
          <% } else if (database === 'postgres') { %>
          - postgres
          <% } %>
        script:
          - npm ci --cache .npm --prefer-offline
          - npm run lint
          - export NODE_ENV=test
          <% if (database === 'mongodb') { %>
          - export MONGODB_URI=mongodb://localhost:27017/test_db
          <% } else if (database === 'mysql') { %>
          - export DB_HOST=localhost
          - export DB_PORT=3306
          - export DB_USERNAME=root
          - export DB_PASSWORD=root
          - export DB_DATABASE=test_db
          <% } else if (database === 'postgres') { %>
          - export DB_HOST=localhost
          - export DB_PORT=5432
          - export DB_USERNAME=testuser
          - export DB_PASSWORD=testpassword
          - export DB_DATABASE=test_db
          <% } %>
          - echo "Running tests with database: <%= database %>"
          - npm run test
          - npm run build
        artifacts:
          - dist/**
    - step: &deploy-staging
        name: Deploy to Staging
        deployment: staging
        trigger: manual
        script:
          - echo "Deploying to staging... (replace with actual commands)"
          - echo "Need to prepare deployment artifact if not done in build step (e.g., tar -czf dist.tar.gz dist)"
    - step: &deploy-production
        name: Deploy to Production
        deployment: production
        trigger: manual
        script:
          - echo "Deploying to production... (replace with actual commands)"
          - echo "Need to prepare deployment artifact if not done in build step (e.g., tar -czf dist.tar.gz dist)"

pipelines:
  default:
    - step: *build-test
  branches:
    main:
      - step: *build-test
      - step: *deploy-production
    develop:
      - step: *build-test
      - step: *deploy-staging
    feature/*:
      - step: *build-test
  pull-requests:
    '**':
      - step: *build-test
  tags:
    'v*':
      - step: *build-test
      - step: *deploy-production

options:
  max-time: 30
  size: 2x
