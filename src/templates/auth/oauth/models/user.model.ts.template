import mongoose, { Document, Schema } from 'mongoose';

export interface IUser extends Document {
  email: string;
  name: string;
  provider: string;
  providerId: string;
  lastLogin: Date;
  createdAt: Date;
  updatedAt: Date;
}

const userSchema = new Schema<IUser>(
  {
    email: {
      type: String,
      required: true,
      unique: true,
      trim: true,
      lowercase: true,
    },
    name: {
      type: String,
      required: true,
      trim: true,
    },
    provider: {
      type: String,
      required: true,
      enum: ['google', 'github'],
    },
    providerId: {
      type: String,
      required: true,
    },
    lastLogin: {
      type: Date,
      default: Date.now,
    },
  },
  {
    timestamps: true,
  }
);

// Create index for faster lookup
userSchema.index({ provider: 1, providerId: 1 }, { unique: true });

export interface UserModel extends mongoose.Model<IUser> {
  findByProvider(provider: string, providerId: string): Promise<IUser | null>;
  updateLastLogin(userId: string): Promise<void>;
}

// Static methods
userSchema.statics.findByProvider = async function(
  provider: string,
  providerId: string
): Promise<IUser | null> {
  return this.findOne({ provider, providerId });
};

userSchema.statics.updateLastLogin = async function(userId: string): Promise<void> {
  await this.findByIdAndUpdate(userId, { lastLogin: new Date() });
};

// Export model
export const UserModel = mongoose.model<IUser, UserModel>('User', userSchema); 