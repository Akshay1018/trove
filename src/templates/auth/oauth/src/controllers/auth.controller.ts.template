import { Request, Response } from 'express';
import { UserModel } from '../models/user.model';
import { logger } from '../utils/logger';

/**
 * Render login page with OAuth providers
 */
export const login = (req: Request, res: Response): void => {
  res.render('auth/login', {
    providers: ['google', 'github'],
    title: 'Login - OAuth Authentication',
  });
};

/**
 * Handle logout
 */
export const logout = (req: Request, res: Response): void => {
  try {
    req.logout((err) => {
      if (err) {
        logger.error('Logout error:', err);
        return res.status(500).json({ message: 'Error during logout' });
      }
      res.redirect('/');
    });
  } catch (error) {
    logger.error('Logout error:', error);
    res.status(500).json({ message: 'Error during logout' });
  }
};

/**
 * Get user profile
 */
export const getProfile = async (req: Request, res: Response): Promise<void> => {
  try {
    if (!req.user) {
      res.status(401).json({ message: 'Not authenticated' });
      return;
    }

    const user = await UserModel.findById(req.user.id).select('-__v');
    if (!user) {
      res.status(404).json({ message: 'User not found' });
      return;
    }

    // Return user profile without sensitive information
    const { password, ...profile } = user.toObject();
    res.json(profile);
  } catch (error) {
    logger.error('Get profile error:', error);
    res.status(500).json({ message: 'Error fetching user profile' });
  }
};

/**
 * OAuth callback handler
 */
export const oauthCallback = (provider: string) => {
  return (req: Request, res: Response): void => {
    // This function doesn't need a body as it's handled by passport middleware
    // The authenticate callback middleware will redirect appropriately
  };
}; 