# Application
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=24h

<% if (database === 'mongodb') { %># MongoDB
MONGODB_URI=mongodb://localhost:27017/<%= projectName %><% } %>

<% if (database === 'postgres' || database === 'mysql') { %># Database
DB_HOST=localhost
DB_PORT=<% if (database === 'postgres') { %>5432<% } else { %>3306<% } %>
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=<%= projectName %><% } %> 