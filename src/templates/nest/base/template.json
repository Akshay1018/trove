{
  "name": "nest-base",
  "description": "Base template for NestJS applications",
  "files": [
    {
      "source": "src/main.ts.ejs",
      "target": "src/main.ts"
    },
    {
      "source": "src/app.module.ts.ejs",
      "target": "src/app.module.ts"
    },
    {
      "source": "src/users/users.module.ts.ejs",
      "target": "src/users/users.module.ts"
    },
    {
      "source": "src/users/users.service.ts.ejs",
      "target": "src/users/users.service.ts"
    },
    {
      "source": "src/users/entities/user.entity.ts.ejs",
      "target": "src/users/entities/user.entity.ts"
    },
    {
      "source": "src/auth/auth.module.ts.ejs",
      "target": "src/auth/auth.module.ts"
    },
    {
      "source": "src/auth/auth.service.ts.ejs",
      "target": "src/auth/auth.service.ts"
    },
    {
      "source": "src/auth/auth.controller.ts.ejs",
      "target": "src/auth/auth.controller.ts"
    },
    {
      "source": "src/auth/strategies/jwt.strategy.ts.ejs",
      "target": "src/auth/strategies/jwt.strategy.ts"
    },
    {
      "source": "src/auth/guards/jwt-auth.guard.ts.ejs",
      "target": "src/auth/guards/jwt-auth.guard.ts"
    },
    {
      "source": "src/auth/dto/register.dto.ts.ejs",
      "target": "src/auth/dto/register.dto.ts"
    },
    {
      "source": "src/auth/dto/login.dto.ts.ejs",
      "target": "src/auth/dto/login.dto.ts"
    },
    {
      "source": "package.json.ejs",
      "target": "package.json"
    },
    {
      "source": ".env.example",
      "target": ".env.example"
    },
    {
      "source": ".gitignore",
      "target": ".gitignore"
    },
    {
      "source": "tsconfig.json",
      "target": "tsconfig.json"
    },
    {
      "source": ".eslintrc.json",
      "target": ".eslintrc.json"
    },
    {
      "source": ".prettierrc",
      "target": ".prettierrc"
    },
    {
      "source": "jest.config.js",
      "target": "jest.config.js"
    },
    {
      "source": "README.md",
      "target": "README.md"
    },
    {
      "source": "nest-cli.json",
      "target": "nest-cli.json"
    }
  ]
} 